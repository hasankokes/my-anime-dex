{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web-site",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "8765", "--directory", "web"],
      "port": 8765
    },
    {
      "name": "expo-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["expo", "start", "--web", "--port", "8091"],
      "env": { "EXPO_NO_TELEMETRY": "1", "EXPO_OFFLINE": "1" },
      "port": 8091
    }
  ]
}
