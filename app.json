{
  "expo": {
    "name": "MyAnimeDex",
    "slug": "myanimedex",
    "version": "1.0.16",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myanimedex",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.myanimedex.app",
      "buildNumber": "17",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleLocalizations": [
          "en",
          "tr",
          "ja",
          "ru",
          "de",
          "ar",
          "es",
          "pt",
          "id",
          "hi",
          "fr",
          "it",
          "pl",
          "vi",
          "th"
        ]
      },
      "associatedDomains": [
        "applinks:myanimedex.com"
      ]
    },
    "android": {
      "package": "com.myanimedex.app",
      "versionCode": 19,
      "permissions": [
        "com.android.vending.BILLING"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "statusBar": {
        "translucent": true,
        "backgroundColor": "#00000000"
      },
      "navigationBar": {
        "visible": "true",
        "backgroundColor": "#00000000"
      },
      "splash": {
        "image": "./assets/images/splash-lightcover.png",
        "resizeMode": "cover",
        "backgroundColor": "#ffffff",
        "dark": {
          "image": "./assets/images/splash-dark-cover.png",
          "backgroundColor": "#1A1A1A"
        }
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "myanimedex.com",
              "pathPrefix": "/lists/"
            },
            {
              "scheme": "https",
              "host": "myanimedex.com",
              "pathPrefix": "/a/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "splash": {
      "image": "./assets/images/splash-lightcover.png",
      "resizeMode": "cover",
      "backgroundColor": "#ffffff",
      "dark": {
        "image": "./assets/images/splash-dark-cover.png",
        "backgroundColor": "#1A1A1A"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "This identifier will be used to deliver personalized ads to you."
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-5358007170177982~5033603669",
          "iosAppId": "ca-app-pub-5358007170177982~9623309693"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "expo-localization",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#FACC15"
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "MyAnimeDex adds the airing times of the anime you follow to your calendar when you ask it to.",
          "remindersPermission": "MyAnimeDex only adds anime airing times to your calendar and never reads your reminders."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "MyAnimeDex uses your photo library so you can choose a profile picture.",
          "cameraPermission": "MyAnimeDex uses the camera so you can take a profile picture.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4bbd49c7-f9ae-485d-a3ac-254ec3571405"
      }
    },
    "locales": {
      "tr": "./locales/tr.json",
      "ja": "./locales/ja.json",
      "ru": "./locales/ru.json",
      "de": "./locales/de.json",
      "ar": "./locales/ar.json",
      "es": "./locales/es.json",
      "pt": "./locales/pt.json",
      "id": "./locales/id.json",
      "hi": "./locales/hi.json",
      "fr": "./locales/fr.json",
      "it": "./locales/it.json",
      "pl": "./locales/pl.json",
      "vi": "./locales/vi.json",
      "th": "./locales/th.json"
    }
  }
}
